# Proveedor de IA: "openrouter", "gemini" u "openai".
# Si se deja vacío, se detecta automáticamente según la API key presente.
AI_PROVIDER=

# --- OpenRouter (recomendado: un solo key para todos los modelos) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna

# --- Google Gemini (alternativa directa: tier gratuito y lectura nativa de PDF) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (alternativa directa) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
