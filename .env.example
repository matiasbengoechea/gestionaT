# Proveedor de IA: "openrouter", "gemini" u "openai".
# Si se deja vacío, se detecta automáticamente según la API key presente.
AI_PROVIDER=openrouter

# --- OpenRouter (recomendado: un solo key para todos los modelos) ---
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=openai/gpt-6-luna

# --- Google Gemini (alternativa directa: tier gratuito y lectura nativa de PDF) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (alternativa directa) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Cotizaciones (conversion a pesos) ---
# FX_ENABLED=false desactiva la conversion automatica.
FX_ENABLED=true
# Casa del dolar en ArgentinaDatos: oficial, blue, bolsa, contadoconliqui, mayorista, tarjeta.
FX_TIPO=oficial
# Lado de la cotizacion: venta o compra.
FX_LADO=venta
